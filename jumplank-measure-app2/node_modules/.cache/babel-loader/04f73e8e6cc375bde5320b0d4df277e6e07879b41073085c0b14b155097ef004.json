408\\u610F\\u7BA1\\u8F44\\u88C1\\u5224\\u6240\\u3068\\u3057\\u307E\\u3059\\u3002\"}),/*#__PURE__*/_jsx(\"h2\",{children:\"\\u7B2C14\\u6761\\uFF08\\u554F\\u3044\\u5408\\u308F\\u305B\\u5148\\uFF09\"}),/*#__PURE__*/_jsxs(\"address\",{children:[/*#__PURE__*/_jsxs(\"strong\",{children:[appName,\" \\u30B5\\u30DD\\u30FC\\u30C8\"]}),/*#__PURE__*/_jsx(\"br\",{}),\"DM: \",/*#__PURE__*/_jsx(\"a\",{href:\"https://x.com/take25862192\",children:\"\\u958B\\u767A\\u8005\\u306EX\"})]}),/*#__PURE__*/_jsxs(\"div\",{className:\"mt-6 flex gap-3\",children:[/*#__PURE__*/_jsx(\"button\",{onClick:()=>window.print(),className:\"px-4 py-2 rounded-lg border shadow-sm hover:shadow-md\",children:\"\\u5370\\u5237\\u3059\\u308B\"}),/*#__PURE__*/_jsx(\"button\",{onClick:()=>{var _navigator$clipboard;return(_navigator$clipboard=navigator.clipboard)===null||_navigator$clipboard===void 0?void 0:_navigator$clipboard.writeText(document.documentElement.innerText);},className:\"px-4 py-2 rounded-lg border shadow-sm hover:shadow-md\",children:\"\\u30C6\\u30AD\\u30B9\\u30C8\\u3092\\u30B3\\u30D4\\u30FC\"})]}),/*#__PURE__*/_jsx(\"footer\",{className:\"mt-8 text-sm text-gray-500\",children:/*#__PURE__*/_jsx(\"p\",{children:\"\\u203B \\u672C\\u30C6\\u30F3\\u30D7\\u30EC\\u30FC\\u30C8\\u306F\\u4E00\\u822C\\u7684\\u306A\\u30B5\\u30F3\\u30D7\\u30EB\\u3067\\u3059\\u3002\\u6CD5\\u7684\\u306A\\u6709\\u52B9\\u6027\\u3092\\u4FDD\\u8A3C\\u3059\\u308B\\u3082\\u306E\\u3067\\u306F\\u3042\\u308A\\u307E\\u305B\\u3093\\u3002\\u5FC5\\u8981\\u306B\\u5FDC\\u3058\\u3066\\u5F01\\u8B77\\u58EB\\u7B49\\u306E\\u5C02\\u9580\\u5BB6\\u306B\\u3054\\u76F8\\u8AC7\\u304F\\u3060\\u3055\\u3044\\u3002\"})})]})]});}","map":{"version":3,"names":["React","jsxs","_jsxs","jsx","_jsx","TermsOfService","_ref","appName","lastUpdated","className","children","href","onClick","window","print","_navigator$clipboard","navigator","clipboard","writeText","document","documentElement","innerText"],"sources":["/Users/tokutake/Desktop/my_app/jump-rank-measure/jumplank-measure-app2/src/termsofservice.tsx"],"sourcesContent":["import React from \"react\";\n\n/**\n * TermsOfService React component\n * Props:\n *  - appName: string (アプリ名)\n *  - contactEmail: string (問い合わせメールアドレス)\n *  - lastUpdated: string (最終更新日)\n *\n * Tailwind CSS 用スタイルを使用しています。\n */\n\nexport default function TermsOfService({\n  appName = \"週刊少年ジャンプ連載作品の順位管理アプリ\",\n  lastUpdated = \"2025-10-11\",\n}) {\n  return (\n    <main className=\"max-w-4xl mx-auto p-6 bg-white rounded-2xl shadow-md\">\n      <header className=\"mb-6\">\n        <h1 className=\"text-3xl font-bold mb-1\">{appName} の利用規約</h1>\n        <p className=\"text-sm text-gray-500\">最終更新日: {lastUpdated}</p>\n      </header>\n\n      <section className=\"prose prose-lg\">\n        <h2>第1条（適用）</h2>\n        <p>\n          本規約は、{appName}（以下「本サービス」）の提供条件および利用に関する当社とユーザーとの間の権利義務を定めるものです。ユーザーは本規約に同意した上で本サービスを利用するものとします。\n        </p>\n\n        <h2>第2条（定義）</h2>\n        <p>\n          本規約において使用する用語の定義は、別段の定めがない限り以下のとおりとします。\n        </p>\n        <ul>\n          <li>「ユーザー」：本サービスを利用する個人または法人。</li>\n          <li>「当社」：本サービスの提供者（運営者）。</li>\n        </ul>\n\n        <h2>第3条（利用登録）</h2>\n        <p>\n          本サービスの利用を希望する者は、当社の定める方法により利用登録を行うものとします。登録内容に虚偽がある場合、当社は登録を取り消すことができます。\n        </p>\n\n        <h2>第4条（アカウント管理）</h2>\n        <p>\n          ユーザーは、自己の責任でアカウント情報を管理するものとし、第三者による不正利用が発覚した場合は直ちに当社に連絡するものとします。\n        </p>\n\n        <h2>第5条（禁止事項）</h2>\n        <p>ユーザーは、以下の行為を行ってはなりません：</p>\n        <ul>\n          <li>法令または公序良俗に違反する行為</li>\n          <li>他のユーザー、第三者の権利を侵害する行為</li>\n          <li>本サービスの運営を妨げる行為、またはその恐れのある行為</li>\n          <li>その他当社が不適切と判断する行為</li>\n        </ul>\n\n        <h2>第6条（知的財産権）</h2>\n        <p>\n          本サービスに関する著作権、商標等の知的財産権は当社または正当な権利を有する第三者に帰属します。ユーザーは当社の許可なく複製、転載、改変等を行ってはなりません。\n        </p>\n\n        <h2>第7条（サービスの提供停止・変更）</h2>\n        <p>\n          当社は、必要と判断した場合にはユーザーへの事前通知なく、本サービスの全部または一部を停止、変更することができます。重大な変更がある場合は適宜告知します。\n        </p>\n\n        <h2>第8条（有償サービス・料金）</h2>\n        <p>\n          本サービスの一部に有償機能がある場合、当社は別途定める料金表に従って課金を行います。ユーザーは定められた料金を支払うものとします。\n        </p>\n\n        <h2>第9条（免責事項）</h2>\n        <ol>\n          <li>当社は、本サービスの利用によりユーザーに生じた損害について、当社の故意または重過失がある場合を除き、一切責任を負いません。</li>\n          <li>当社は、本サービス上の情報の正確性・安全性等を保証するものではありません。</li>\n        </ol>\n\n        <h2>第10条（利用停止・登録抹消）</h2>\n        <p>\n          当社は、ユーザーが本規約に違反した場合、事前の通知なく利用停止または登録抹消を行うことができます。\n        </p>\n\n        <h2>第11条（退会）</h2>\n        <p>\n          ユーザーは当社の定める方法により退会できるものとします。退会後も、法令に基づき保存が必要な情報は当社の判断で保管される場合があります。\n        </p>\n\n        <h2>第12条（変更）</h2>\n        <p>\n          当社は本規約をいつでも変更できるものとします。重要な変更がある場合は事前に告知します。変更後の規約はウェブ上に表示された時点で効力を生じます。\n        </p>\n\n        <h2>第13条（準拠法・裁判管轄）</h2>\n        <p>\n          本規約の準拠法は日本法とし、本規約に関して紛争が生じた場合、東京地方裁判所を第一審の専属的合意管轄裁判所とします。\n        </p>\n\n        <h2>第14条（問い合わせ先）</h2>\n        <address>\n          <strong>{appName} サポート</strong>\n          <br />\n          DM: <a href=\"https://x.com/take25862192\">開発者のX</a>\n        </address>\n\n        <div className=\"mt-6 flex gap-3\">\n          <button\n            onClick={() => window.print()}\n            className=\"px-4 py-2 rounded-lg border shadow-sm hover:shadow-md\"\n          >\n            印刷する\n          </button>\n          <button\n            onClick={() => navigator.clipboard?.writeText(document.documentElement.innerText)}\n            className=\"px-4 py-2 rounded-lg border shadow-sm hover:shadow-md\"\n          >\n            テキストをコピー\n          </button>\n        </div>\n\n        <footer className=\"mt-8 text-sm text-gray-500\">\n          <p>※ 本テンプレートは一般的なサンプルです。法的な有効性を保証するものではありません。必要に応じて弁護士等の専門家にご相談ください。</p>\n        </footer>\n      </section>\n    </main>\n  );\n}\n"],"mappings":"AAAA,MAAO,CAAAA,KAAK,KAAM,OAAO,CAEzB;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA,GARA,OAAAC,IAAA,IAAAC,KAAA,CAAAC,GAAA,IAAAC,IAAA,yBAUA,cAAe,SAAS,CAAAC,cAAcA,CAAAC,IAAA,CAGnC,IAHoC,CACrCC,OAAO,CAAG,sBAAsB,CAChCC,WAAW,CAAG,YAChB,CAAC,CA